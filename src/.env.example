# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL="postgresql://saas_user:saas_password@localhost:5432/saas_citas?schema=public"

# --- Auth ---
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too-different-from-jwt-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- WhatsApp (backlog - Fase 1 MVP / Bloque 4) ---
WHATSAPP_PROVIDER="meta_cloud_api"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App Secret de tu app de Meta, usada para verificar la firma HMAC de los
# mensajes entrantes (bot conversacional, Bloque 7.2). Sin ella, el webhook
# de entrada sigue funcionando en modo desarrollo, pero sin verificar firma.
WHATSAPP_APP_SECRET=""

# --- Email fallback (backlog) ---
EMAIL_PROVIDER="smtp"
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASSWORD=""

# --- Stripe (backlog - Fase 3) ---
# --- Stripe (Bloque 7 - Billing) ---
# Ver docs/whatsapp-pricing-study.md para la metodología de precios completa.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Precio recurrente base de cada plan (crear en el Dashboard de Stripe:
# Products > Add product > Recurring). El plan Free no tiene Price.
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_BUSINESS=""
STRIPE_PRICE_ID_MULTI_LOCATION=""

# Precio "metered" (uso medido) para el exceso de mensajes de WhatsApp de
# cada plan, en la misma suscripción. Crear en Stripe como Price de tipo
# "Usage is metered", unidad = "mensaje de WhatsApp", modelo de precio
# "Package pricing" (p.ej. 1000 unidades = precio_exceso_por_mensaje * 1000,
# para evitar precios de fracciones de céntimo por unidad individual).
STRIPE_PRICE_ID_PRO_METERED_WHATSAPP=""
STRIPE_PRICE_ID_BUSINESS_METERED_WHATSAPP=""
STRIPE_PRICE_ID_MULTI_LOCATION_METERED_WHATSAPP=""

# URL del frontend, usada para construir las URLs de éxito/cancelación de
# Stripe Checkout cuando la petición no incluye cabecera Origin.
FRONTEND_URL="http://localhost:4200"

# --- Webhooks salientes (backlog - Fase 4) ---
# --- Webhooks salientes (Bloque 6) ---
# Clave maestra de 32 bytes (64 caracteres hex) usada para cifrar el secreto
# de cada webhook en reposo. Genera una con: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY="change-me-generate-with-openssl-rand-hex-32"

# --- Queue / Redis (BullMQ - Bloque 5: recordatorios automáticos y workflows) ---
REDIS_URL="redis://localhost:6379"

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
